{
  "version": 2,
  "installCommand": "MONGOMS_DISABLE_POSTINSTALL=1 npm install --include=dev",
  "buildCommand": "npm run build",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "outputDirectory": "public",
  "crons": [
    {
      "path": "/api/jobs/refresh-overdue",
      "schedule": "0 2 * * *"
    }
  ]
}
