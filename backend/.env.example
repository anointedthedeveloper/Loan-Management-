NODE_ENV=development
PORT=4000
# Connection string for MongoDB (Atlas or self-hosted). Use a dedicated least-privilege DB user.
MONGODB_URI=mongodb://127.0.0.1:27017/protech_loans
# Long random string (>= 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret-value-please
JWT_EXPIRES_IN=8h
JWT_REMEMBER_EXPIRES_IN=30d
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
BCRYPT_ROUNDS=12
# Used only by `npm run seed` (development/demo data)
SEED_CEO_PASSWORD=Protech@CEO2026
SEED_ACCOUNTANT_PASSWORD=Protech@Acct2026
